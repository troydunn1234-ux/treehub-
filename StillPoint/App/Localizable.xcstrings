      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras el calor"
          }
        }
      }
    },
    "After sauna or steam days your %@ averaged %lld %@ (%lld mornings), against %lld %@ on other days (%lld mornings).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras los días de sauna o vapor, tu %1$@ fue de %2$lld %3$@ de media (%4$lld mañanas), frente a %5$lld %6$@ en otros días (%7$lld mañanas)."
          }
        }
      }
    },
    "Also save as a workout": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar también como entrenamiento"
          }
        }
