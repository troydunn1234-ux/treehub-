      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra ronda"
          }
        }
      }
    },
    "Any session of a minute or more keeps the streak, sauna and steam included.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier sesión de un minuto o más mantiene la racha, sauna y vapor incluidos."
          }
        }
      }
    },
    "Any session of a minute or more keeps the streak: sauna, steam and Rootbound tree hugs included.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier sesión de un minuto o más mantiene la racha: sauna, vapor y abrazos a árboles de Rootbound incluidos."
