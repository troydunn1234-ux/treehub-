    "Adds a sauna, steam or breathing session you already did, ending now.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una sesión de sauna, vapor o respiración que ya hiciste, terminando ahora."
