          "stringUnit": {
            "state": "translated",
            "value": "Antes y después de entrenar, el baño frío y la sauna."
          }
        }
      }
    },
    "Get out of your head and back into your body and the world around you.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sal de tu cabeza y vuelve a tu cuerpo y al mundo que te rodea."
