    "Gentle practices for recovery, easing discomfort, grief and deep rest.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prácticas suaves para la recuperación, aliviar molestias, el duelo y el descanso profundo."
          }
        }
      }
    },
    "Slow the heart and quiet worry, from a 1-minute SOS to longer sits.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calma el corazón y la preocupación, desde un SOS de 1 minuto hasta sesiones más largas."
          }
        }
      }
    },
    "Unwind the body and mind at night so sleep comes more easily.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Relaja cuerpo y mente por la noche para dormir con más facilidad."
          }
        }
      }
    },
    "Wake up, warm up and lift a flat mood without caffeine.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Despierta, entra en calor y levanta el ánimo sin cafeína."
          }
        }
      }
    },
    "Steady, clear attention for work, study or a big moment.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atención clara y estable para el trabajo, el estudio o un gran momento."
          }
        }
      }
    },
    "Before and after training, the cold plunge and the sauna.": {
      "extractionState": "manual",
      "localizations": {
