    "Turn voice guide on": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar la guía de voz"
          }
        }
      }
    },
    "Using WHOOP? Turn on the Apple Health integration in the WHOOP app and allow Heart Rate. Still Point reads the readings that fall inside each sauna or steam session. An Apple Watch or Garmin works the same way.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Usas WHOOP? Activa la integración con Salud en la app de WHOOP y permite Frecuencia cardiaca. Still Point lee las mediciones que caen dentro de cada sesión de sauna o vapor. Un Apple Watch o un Garmin funcionan igual."
          }
        }
      }
    },
    "Usual length": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duración habitual"
          }
        }
      }
    },
