    },
    "WHAT SETTLES YOU MOST": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LO QUE MÁS TE CALMA"
          }
        }
      }
    },
    "WHOOP's recovery score isn't shared with Apple Health, but the HRV and resting heart rate it measures are, so they count here. HRV is the morning average (midnight to noon).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La puntuación de recuperación de WHOOP no se comparte con Salud, pero la VFC y la frecuencia cardiaca en reposo que mide sí, así que cuentan aquí. La VFC es la media de la mañana (de medianoche a mediodía)."
          }
        }
      }
    },
    "Warm-ups count as mindful minutes": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los calentamientos cuentan como minutos de atención plena"
          }
        }
      }
    },
