<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.troydunn.pulselab.refresh</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Pulse Lab</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>es</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.troydunn.pulselab</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pulselab</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>whoop</string>
		<string>stillpoint</string>
		<string>rootbound</string>
		<string>roamr</string>
	</array>
	<key>NSHealthShareUsageDescription</key>
	<string>Pulse Lab reads your heart, sleep, activity and workout data from Apple Health (including what WHOOP saves there) to compare your Apple Watch and WHOOP side by side.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Pulse Lab saves the supplements you check off in your Stack to Apple Health as nutrients (like vitamin D or magnesium). It never changes your heart, sleep or workout data.</string>
	<key>PLCloudSync</key>
	<false/>
	<key>PaidUntilBuild</key>
	<integer>0</integer>
	<key>ProProductID</key>
	<string>com.troydunn.pulselab.pro</string>
	<key>SubscriptionProductIDs</key>
	<array>
		<string>com.troydunn.pulselab.pro.yearly</string>
		<string>com.troydunn.pulselab.pro.monthly</string>
	</array>
	<key>TrialProductID</key>
	<string>com.troydunn.pulselab.none</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>WhoopClientID</key>
	<string>$(WHOOP_CLIENT_ID)</string>
	<key>WhoopClientSecret</key>
	<string>$(WHOOP_CLIENT_SECRET)</string>
</dict>
</plist>
