      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Referencia: últimos %lld días"
          }
        }
      }
    },
    "Baseline: the average of the 14 days before, once at least 10 of them have readings; until then, the last 7 days.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Referencia: el promedio de los 14 días anteriores, cuando al menos 10 tienen lecturas; hasta entonces, los últimos 7 días."
          }
        }
      }
    },
