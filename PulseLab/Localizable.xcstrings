      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir leer bebidas"
          }
        }
      }
    },
    "Apple Watch measures SDNN, WHOOP measures RMSSD, so WHOOP usually reads higher. Compare the shape of the lines, not the gap.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple Watch mide SDNN y WHOOP mide RMSSD, así que WHOOP suele marcar más alto. Compara la forma de las líneas, no la diferencia."
          }
        }
      }
    },
    "Apple Watch reads higher on %lld of %lld metrics.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple Watch marca más alto en %lld de %lld métricas."
          }
        }
      }
    },
    "Apple Watch versus WHOOP": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch frente a WHOOP"
          }
        }
      }
    },
    "Apple counts active + resting energy; WHOOP reports one total per cycle (converted from kJ). Faded bars are still counting (today on the Watch, the open cycle on WHOOP), so don't compare those yet.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple cuenta la energía activa + en reposo; WHOOP da un total por ciclo (convertido de kJ). Las barras atenuadas aún están contando (hoy en el Watch, el ciclo abierto en WHOOP), así que no las compares todavía."
          }
        }
      }
    },
    "Ask me for WHOOP numbers each morning": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedirme los números de WHOOP cada mañana"
          }
        }
      }
    },
