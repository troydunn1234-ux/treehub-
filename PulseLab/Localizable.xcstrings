    "The final score is kept between 1 and 99. 67 and up is high, 34–66 moderate, below 34 low — the same bands WHOOP uses.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La puntuación final se mantiene entre 1 y 99. De 67 en adelante es alta, de 34 a 66 moderada y por debajo de 34 baja: las mismas franjas que usa WHOOP."
          }
        }
      }
    },
    "The points add up to %lld; the score is held between 1 and 99.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los puntos suman %lld; la puntuación se mantiene entre 1 y 99."
          }
