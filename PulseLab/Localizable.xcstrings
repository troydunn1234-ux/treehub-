    "%lld metrics measured by both. Crowns go to the tracker that reads higher, or the steadier one when they match.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld métricas medidas por ambos. Las coronas van al dispositivo que marca más alto, o al más estable cuando coinciden."
