    },
    "HRV is above your 30-day baseline this morning, a sign you're well rested by your own standard.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu VFC está por encima de tu referencia de 30 días esta mañana: según tus propios datos, estás bien descansado."
