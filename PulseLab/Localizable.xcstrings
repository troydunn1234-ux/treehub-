    "8 am by default. It asks you to log WHOOP when today's numbers are missing. Change it any time in Settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A las 8 am por defecto. Te pide registrar WHOOP cuando faltan los números de hoy. Cámbialo cuando quieras en Ajustes."
          }
        }
      }
    },
    "8 h goal": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta de 8 h"
          }
        }
      }
    },
    "A few more days where both trackers measured the same thing and the verdict fills in.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unos días más en los que ambos dispositivos midan lo mismo y el veredicto se completará."
          }
        }
      }
    },
