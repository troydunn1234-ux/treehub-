      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por debajo de tu rango normal (%@)"
          }
        }
      }
    },
    "Below your usual. An easier day and an early night may help.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por debajo de lo habitual. Un día más suave y acostarte temprano pueden ayudar."
          }
        }
      }
    },
    "Best trend match: %@ (r = %@).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendencias más parecidas: %@ (r = %@)."
          }
        }
      }
    },
    "Big day yesterday (strain %@). Recovery often trails a hard day by one morning.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayer fue un día intenso (esfuerzo %@). La recuperación suele ir un día por detrás de un día duro."
          }
        }
      }
    },
