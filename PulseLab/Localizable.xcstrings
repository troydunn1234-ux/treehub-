    "Connect WHOOP": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectar WHOOP"
          }
        }
      }
    },
    "Connect WHOOP for recovery, strain and sleep, or type the numbers in each morning in about 20 seconds. Check off supplements in the Stack tab so Insights can compare.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta WHOOP para recuperación, esfuerzo y sueño, o escribe los números cada mañana en unos 20 segundos. Marca los suplementos en la pestaña Stack para que Análisis pueda comparar."
          }
        }
      }
    },
    "Connect WHOOP in Settings, or log recovery by hand, to compare the two scores.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta WHOOP en Ajustes, o registra la recuperación a mano, para comparar las dos puntuaciones."
          }
        }
      }
    },
    "Connected": {
      "localizations": {
